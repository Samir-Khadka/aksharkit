 "sequences": [
  {
   "keys": "km",
   "families": [
    "A",
    "B",
    "C"
   ],
   "to": "फ",
   "how": "A: rule 'प + m'; B: replaces 'km'; C: array entry 'km'"
  },
  {
   "keys": "qm",
   "families": [
    "A",
    "B",
    "C"
   ],
   "to": "क्र",
   "how": "A: rule 'त्र + m'; B: replaces 'qm' with the keys for क + ्र; C: array entry 'qm'"
  },
  {
   "keys": "Qm",
   "families": [
    "A",
    "C"
   ],
   "to": "क्त",
   "how": "A: rule 'त्त + m'; C: array entry 'Qm'"
  },
  {
   "keys": "em",
   "families": [
    "A",
    "C"
   ],
   "to": "झ",
   "how": "A: rule 'भ + m'; C: array entry 'em'"
  },
  {
   "keys": "pm",
   "families": [
    "A",
    "C"
   ],
   "to": "ऊ",
   "how": "A: rule 'उ + m'; C: array entry 'pm'"
  },
  {
   "keys": "{",
   "families": [
    "A",
    "B"
   ],
   "rule": "reph: र् placed before the syllable it was typed after",
   "how": "A: rules move '{' back and turn it into र्; B: maps '{' to र् and moves it before the preceding letter"
  },
  {
   "keys": "O{",
   "families": [
    "A",
    "C"
   ],
   "rule": "ई",
   "how": "A: rule 'इ + {'; C: array entry 'O{'"
  },
  {
   "keys": "l",
   "families": [
    "A",
    "B",
    "C"
   ],
   "rule": "ि typed before the consonant it follows in Unicode",
   "how": "all three move it after the following letter or cluster"
  },
  {
   "keys": "<half form> f",
   "families": [
    "A",
    "B",
    "C"
   ],
   "rule": "the full letter (ण् + ा = ण, क्ष् + ा = क्ष, ष् + ा = ष)",
   "how": "A and C: virama + ा removed; B: replaces '0f', 'If', 'if'"
  },
  {
   "keys": "m after a vowel sign",
   "families": [
    "A",
    "C"
   ],
   "rule": "still belongs to the consonant before the sign",
   "how": "A: rule moves m back over other letters; C: array entries \"'m\", ']m', 'Fm'"
  },
  {
   "keys": "k|m",
   "families": [
    "C"
   ],
   "rule": "फ्र",
   "how": "C: array entry; A's general rule also moves m back over ्र"
  },
  {
   "keys": "8Þ",
   "families": [
    "C"
   ],
   "to": "ड़",
   "how": "C: array entry"
  },
  {
   "keys": "9Þ",
   "families": [
    "C"
   ],
   "to": "ढ़",
   "how": "C: array entry"
  },
  {
   "keys": "f‘",
   "families": [
    "C"
   ],
   "rule": "ॉ",
   "how": "C: array entry; family A (nepalikit only) has the single key ‘ as ॅ"
  },
  {
   "keys": "N˜",
   "families": [
    "C"
   ],
   "rule": "ल",
   "how": "C: array entry"
  },
  {
   "keys": "M after a space or at line start",
   "families": [
    "A"
   ],
   "rule": ":",
   "how": "A: two rules"
  },
  {
   "keys": "6[",
   "families": [
    "A"
   ],
   "rule": "ट्ट",
   "how": "A: rule 'ट + ृ'"
  }
 ],
 "sequences_note": "Entries with 'to' are key pairs the converter looks up. Entries with 'rule' describe behaviour the converter implements in its own code, or (for one family only) behaviour it does not implement."
